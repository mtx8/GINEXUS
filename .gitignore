Package.resolved

# XcodeGen: generated project + generated Info.plist are build outputs.
# project.yml is the source of truth — regenerate with `cd app && xcodegen generate`.
app/GINEXUS.xcodeproj/
app/Generated/
# local xcodebuild output (CLI verification builds)
app/.xcode-build/

# Python / uv
.venv/
__pycache__/
*.pyc
.uv/
.python-version

# Models & large artifacts (never commit weights)
models/
*.safetensors
*.gguf
*.mlx
*.bin

# Secrets & local config
.env
.env.*
*.key
*.pem
secrets/

# Logs & local data
*.log
data/
.cache/

# iCloud — HARD RULE: never track anything under Mobile Documents
Library/

# Xcode: staged Rust core for the in-Xcode embed (built by the GINEXUS scheme pre-action)
app/artifacts/
