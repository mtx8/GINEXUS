<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>GINEXUS</string>
    <key>CFBundleDisplayName</key>
    <string>GINEXUS</string>
    <key>CFBundleExecutable</key>
    <string>GinexusApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.macktrax.ginexus</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!-- Single-instance: two app instances mint two bearer tokens but share one core socket, so
         the second instance's writes 401 against the core the first spawned. Prohibiting multiple
         instances makes `open` reactivate the existing window instead of launching a rival. -->
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>GINEXUS reads your calendar so the agent can reason about and schedule around your events.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>GINEXUS reads your calendar so the agent can reason about and schedule around your events.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>GINEXUS uses the microphone for hands-free voice conversation — your speech is transcribed locally on this Mac and never leaves the device.</string>
    <!-- SP-FAB: UDP broadcast discovery + printer control on the LAN triggers macOS 15+ Local
         Network privacy; without this string, discovery silently finds nothing. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>GINEXUS finds and monitors your 3D printers on your local network.</string>
</dict>
</plist>
