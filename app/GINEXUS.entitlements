<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SP-Voice: hands-free conversation captures mic audio in the signed app (TCC-attributed),
	     never the sidecar. Required alongside NSMicrophoneUsageDescription under Hardened Runtime. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
